PORT=4000
FRONTEND_URL=http://localhost:5173
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/lms
JWT_SECRET=change-me

CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Brevo transactional API key must start with xkeysib-
# Paste only the key value in Render, not "BREVO_API_KEY=..."
BREVO_API_KEY=xkeysib-your-brevo-api-v3-key
MAIL_FROM=verified-sender@example.com
MAIL_FROM_NAME=StudyNotion

# Optional SMTP fallback. For Gmail, MAIL_PASS must be an app password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-app-password
